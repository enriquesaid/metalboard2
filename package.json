{
  "name": "metalboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "brand:generate": "node scripts/build-brand.mjs && tauri icon src-tauri/app-icon.svg --output src-tauri/icons",
    "test": "node --test tests/*.test.mjs",
    "pretest": "node scripts/build-preview.mjs",
    "predev": "node scripts/build-preview.mjs",
    "prebuild": "node scripts/build-preview.mjs",
    "build:desktop": "npm run build && node -e \"require('fs').rmSync('dist/downloads',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@babel/standalone": "^7.28.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.4",
    "@milkdown/kit": "^7.22.2",
    "@tauri-apps/api": "^2.0.0",
    "@tldraw/assets": "5.4.2",
    "@tldraw/mermaid": "^5.4.2",
    "dompurify": "^3.4.16",
    "idb": "^7.1.1",
    "lucide-react": "^0.468.0",
    "marked": "^18.0.14",
    "mermaid": "^12.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tldraw": "5.4.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/babel__standalone": "^7.1.9",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  }
}
